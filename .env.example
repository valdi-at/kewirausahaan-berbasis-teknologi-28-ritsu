POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ritsu
POSTGRES_PORT=5432

# DATABASE_URL is auto-constructed in docker-compose.yml from the vars above
# only needed for `npm run dev` (local dev outside Docker) — use localhost here ^.^
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/ritsu

# Generate with: openssl rand -base64 32
SESSION_SECRET=
